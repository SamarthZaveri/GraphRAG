# Local app: copy to .env for Docker Compose; Ollama runs on the host.
LEDGER_LLM_BACKEND=ollama
LEDGER_MODEL_PROFILE=14b
OLLAMA_HOST=http://host.docker.internal:11434
LEDGER_EXTRACTION_MODEL=qwen2.5:14b
LEDGER_ANSWER_MODEL=qwen2.5:14b
LEDGER_QUESTION_MODEL=qwen2.5:14b
LEDGER_JUDGE_MODEL=qwen2.5:14b
LEDGER_NUM_CTX=16384
LEDGER_KEEP_ALIVE=0
LEDGER_EXTRACTION_CONCURRENCY=1
LEDGER_QA_INPUT_CHARS=16000
LEDGER_OLLAMA_TIMEOUT=900
