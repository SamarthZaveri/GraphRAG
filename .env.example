# Local app: copy to .env for Docker Compose; Ollama runs on the host.
# Serving uses only the 7B (extraction, classification, answers). The 14B wrote and judged the
# benchmark offline; its name stays here so the trained policy's model metadata matches.
LEDGER_LLM_BACKEND=ollama
OLLAMA_HOST=http://host.docker.internal:11434
LEDGER_EXTRACTION_MODEL=qwen2.5:7b-instruct
LEDGER_QUERY_MODEL=qwen2.5:7b-instruct
LEDGER_ANSWER_MODEL=qwen2.5:7b-instruct
LEDGER_QUESTION_MODEL=qwen2.5:14b
LEDGER_JUDGE_MODEL=qwen2.5:14b
LEDGER_NUM_CTX_BY_MODEL=qwen2.5:7b-instruct=8192,qwen2.5:14b=12288
LEDGER_NUM_CTX=8192
LEDGER_KEEP_ALIVE=30m
LEDGER_EXTRACTION_CONCURRENCY=4
LEDGER_QA_INPUT_CHARS=16000
LEDGER_OLLAMA_TIMEOUT=900
ANONYMIZED_TELEMETRY=False

# Public deployment (uncomment): read-only shared corpus, private expiring upload workspaces,
# CORS limited to the frontend's origin, admin-only maintenance endpoints.
# LEDGER_PUBLIC_MODE=true
# LEDGER_CORS_ORIGINS=https://your-app.vercel.app
# LEDGER_ADMIN_TOKEN=change-me
# LEDGER_GPU_HOURLY_USD=0.526   # cost basis for telemetry: g4dn.xlarge on-demand; 0 on free CPU
# LEDGER_INFERENCE_DEVICE=cpu   # shows the "slow CPU" notice in the UI
# LEDGER_MAX_PDF_PAGES=60
# LEDGER_RESPONSE_CACHE=true    # serve repeated questions on an unchanged corpus from cache
