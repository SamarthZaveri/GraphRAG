# Copy to .env for Docker Compose. PowerShell runs use environment variables.
LEDGER_LLM_BACKEND=api
LEDGER_MODEL_PROFILE=32b
LEDGER_API_BASE_URL=https://router.huggingface.co/v1
HF_TOKEN=
# Separate overrides are optional; by default every role uses the profile.
# LEDGER_EXTRACTION_MODEL=Qwen/Qwen2.5-14B-Instruct
# LEDGER_QUESTION_MODEL=Qwen/Qwen2.5-72B-Instruct
# LEDGER_JUDGE_MODEL=Qwen/Qwen2.5-72B-Instruct
LEDGER_API_JSON_MODE=false
LEDGER_OLLAMA_TIMEOUT=900
LEDGER_QA_PER_CATEGORY=3
LEDGER_QA_INPUT_CHARS=48000
